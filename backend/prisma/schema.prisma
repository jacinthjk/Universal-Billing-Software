// Universal Business Billing & Commerce Platform - data model
// Every business-scoped table carries `businessId` and every query in the API filters by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Platform ─────────────────────────────

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  phone              String?
  passwordHash       String
  isPlatformAdmin    Boolean      @default(false)
  active             Boolean      @default(true)
  // Set when someone else issues a temporary password; the user must choose their own at next login.
  mustChangePassword Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  memberships        Membership[]
}

model Business {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  type             String         @default("RETAIL")
  status           BusinessStatus @default(ACTIVE)
  plan             String         @default("trial")
  phone            String?
  email            String?
  address          String?
  city             String?
  taxId            String?
  currency         String         @default("INR")
  timezone         String         @default("Asia/Kolkata")
  logoUrl          String?
  // bcrypt hash of the optional passcode required to edit or cancel saved bills
  billPasscodeHash String?
  theme            Json           @default("{}")
  terminology      Json           @default("{}")
  settings         Json           @default("{}")
  website          Json           @default("{}")
  ai               Json           @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  locations     Location[]
  roles         Role[]
  memberships   Membership[]
  categories    Category[]
  products      Product[]
  suppliers     Supplier[]
  customers     Customer[]
  purchases     Purchase[]
  sales         Sale[]
  orders        Order[]
  enquiries     Enquiry[]
  stockLedger   StockLedger[]
  sequences     InvoiceSequence[]
  knowledge     KnowledgeItem[]
  conversations AiConversation[]
  dailyReports  DailyReport[]
  auditLogs     AuditLog[]
  notifications Notification[]
  whatsappAuth  WhatsAppAuth[]
  messages      MessageLog[]
  employees     Employee[]
  attendance    Attendance[]
  leaves        LeaveRequest[]
  bankAccounts  BankAccount[]
  bankTxns      BankTransaction[]
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model Location {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Role {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  permissions String[]
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([businessId, name])
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  roleId     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
}

// ───────────────────────────── Masters ─────────────────────────────

model Category {
  id         String    @id @default(cuid())
  businessId String
  name       String
  slug       String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, slug])
}

model Product {
  id             String         @id @default(cuid())
  businessId     String
  sku            String
  barcode        String?
  hsn            String?
  name           String
  kind           ItemKind       @default(PRODUCT)
  categoryId     String?
  brand          String?
  variant        String?
  unit           String         @default("pcs")
  costPrice      Decimal        @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal        @default(0) @db.Decimal(12, 2)
  mrp            Decimal?       @db.Decimal(12, 2)
  taxRate        Decimal        @default(0) @db.Decimal(5, 2)
  trackStock     Boolean        @default(true)
  stockQty       Decimal        @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal?       @db.Decimal(12, 3)
  batchTracking  Boolean        @default(false)
  serialTracking Boolean        @default(false)
  imageUrl       String?
  description    String?
  customFields   Json           @default("{}")
  showOnWebsite  Boolean        @default(true)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches        ProductBatch[]

  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([businessId, barcode])
}

enum ItemKind {
  PRODUCT
  SERVICE
}

model ProductBatch {
  id         String    @id @default(cuid())
  businessId String
  productId  String
  batchNo    String
  expiryDate DateTime?
  qty        Decimal   @default(0) @db.Decimal(12, 3)
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, batchNo])
  @@index([businessId, expiryDate])
}

model Supplier {
  id         String            @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  taxId      String?
  notes      String?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases  Purchase[]
  payments   SupplierPayment[]

  @@index([businessId])
}

model Customer {
  id               String            @id @default(cuid())
  businessId       String
  code             String
  name             String
  phone            String?
  email            String?
  taxId            String?
  address          String?
  city             String?
  notes            String?
  tags             String[]
  isLead           Boolean           @default(false)
  marketingConsent Boolean           @default(false)
  visitCount       Int               @default(0)
  totalSpent       Decimal           @default(0) @db.Decimal(14, 2)
  firstPurchaseAt  DateTime?
  lastPurchaseAt   DateTime?
  createdByAi      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  addresses        CustomerAddress[]
  visits           CustomerVisit[]
  sales            Sale[]
  orders           Order[]
  enquiries        Enquiry[]

  @@unique([businessId, code])
  @@unique([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, name])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  line1      String
  city       String?
  pincode    String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerVisit {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String
  saleId      String   @unique
  visitNumber Int
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

// ───────────────────────────── Purchasing ─────────────────────────────

model Purchase {
  id          String            @id @default(cuid())
  businessId  String
  number      String
  supplierId  String?
  supplierRef String?
  status      PurchaseStatus    @default(RECEIVED)
  date        DateTime          @default(now())
  subtotal    Decimal           @default(0) @db.Decimal(14, 2)
  discount    Decimal           @default(0) @db.Decimal(14, 2)
  tax         Decimal           @default(0) @db.Decimal(14, 2)
  total       Decimal           @default(0) @db.Decimal(14, 2)
  paidAmount  Decimal           @default(0) @db.Decimal(14, 2)
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items       PurchaseItem[]
  payments    SupplierPayment[]

  @@unique([businessId, number])
  @@index([businessId, date])
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  RETURNED
  CANCELLED
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  productId   String
  name        String
  qty         Decimal   @db.Decimal(12, 3)
  returnedQty Decimal   @default(0) @db.Decimal(12, 3)
  unitCost    Decimal   @db.Decimal(12, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  batchNo     String?
  expiryDate  DateTime?
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model SupplierPayment {
  id         String    @id @default(cuid())
  businessId String
  supplierId String
  purchaseId String?
  amount     Decimal   @db.Decimal(14, 2)
  method     String    @default("CASH")
  reference  String?
  date       DateTime  @default(now())
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  id             String         @id @default(cuid())
  businessId     String
  number         String
  customerId     String?
  orderId        String?        @unique
  channel        String         @default("POS")
  status         SaleStatus     @default(COMPLETED)
  subtotal       Decimal        @default(0) @db.Decimal(14, 2)
  discount       Decimal        @default(0) @db.Decimal(14, 2)
  tax            Decimal        @default(0) @db.Decimal(14, 2)
  total          Decimal        @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal        @default(0) @db.Decimal(14, 2)
  paymentStatus  PaymentStatus  @default(PAID)
  customerStatus String?
  // Billing details as printed on the invoice (editable at the POS preview step)
  billName       String?
  billPhone      String?
  billEmail      String?
  billAddress    String?
  billTaxId      String?
  visitNumber    Int?
  notes          String?
  verifyToken    String         @unique @default(cuid())
  editCount      Int            @default(0)
  editedAt       DateTime?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  createdById    String?
  createdAt      DateTime       @default(now())
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  returns        SaleReturn[]
  assets         InvoiceAsset[]

  @@unique([businessId, number])
  @@index([businessId, createdAt])
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  name        String
  hsn         String?
  unit        String?
  qty         Decimal @db.Decimal(12, 3)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String
  method    String
  amount    Decimal  @db.Decimal(14, 2)
  reference String?
  createdAt DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SaleReturn {
  id           String       @id @default(cuid())
  businessId   String
  saleId       String
  number       String
  reason       String?
  total        Decimal      @db.Decimal(14, 2)
  refundMethod String       @default("CASH")
  createdById  String?
  createdAt    DateTime     @default(now())
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items        ReturnItem[]

  @@unique([businessId, number])
}

model ReturnItem {
  id         String     @id @default(cuid())
  returnId   String
  saleItemId String
  productId  String
  qty        Decimal    @db.Decimal(12, 3)
  amount     Decimal    @db.Decimal(14, 2)
  ret        SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id         String   @id @default(cuid())
  businessId String
  key        String
  prefix     String
  next       Int      @default(1)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
}

model InvoiceAsset {
  id        String   @id @default(cuid())
  saleId    String
  kind      String
  path      String
  createdAt DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, kind])
}

// ───────────────────────────── Orders / CRM ─────────────────────────────

model Order {
  id             String             @id @default(cuid())
  businessId     String
  number         String
  kind           OrderKind          @default(ORDER)
  channel        String             @default("WEBSITE")
  status         OrderStatus        @default(PENDING)
  customerId     String?
  enquiryId      String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  fulfilment     String             @default("PICKUP")
  address        String?
  paymentMethod  String             @default("PAY_ON_DELIVERY")
  paymentStatus  PaymentStatus      @default(UNPAID)
  paymentRef     String?
  subtotal       Decimal            @default(0) @db.Decimal(14, 2)
  tax            Decimal            @default(0) @db.Decimal(14, 2)
  total          Decimal            @default(0) @db.Decimal(14, 2)
  notes          String?
  trackingToken  String             @unique @default(cuid())
  createdByAi    Boolean            @default(false)
  idempotencyKey String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  enquiry        Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  reservations   StockReservation[]
  sale           Sale?

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status])
}

enum OrderKind {
  QUOTATION
  ORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  qty       Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StockReservation {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  orderId    String
  qty        Decimal  @db.Decimal(12, 3)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId, productId, status])
}

model Enquiry {
  id           String            @id @default(cuid())
  businessId   String
  customerId   String?
  name         String?
  phone        String?
  email        String?
  source       String            @default("WALK_IN")
  intent       String?
  productId    String?
  itemText     String?
  quantity     String?
  budget       String?
  location     String?
  urgency      String?
  message      String?
  summary      String?
  nextAction   String?
  status       String            @default("NEW")
  priority     String            @default("NORMAL")
  leadScore    Int               @default(0)
  assignedToId String?
  followUpAt   DateTime?
  createdByAi  Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  followups    EnquiryFollowup[]
  orders       Order[]

  @@index([businessId, status])
  @@index([businessId, followUpAt])
}

model EnquiryFollowup {
  id        String   @id @default(cuid())
  enquiryId String
  note      String
  byUserId  String?
  byAi      Boolean  @default(false)
  createdAt DateTime @default(now())
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Inventory ─────────────────────────────

model StockLedger {
  id           String   @id @default(cuid())
  businessId   String
  productId    String
  type         String
  qty          Decimal  @db.Decimal(12, 3)
  balanceAfter Decimal  @db.Decimal(12, 3)
  unitCost     Decimal? @db.Decimal(12, 2)
  refType      String?
  refId        String?
  batchNo      String?
  note         String?
  userId       String?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, productId, createdAt])
  @@index([businessId, createdAt])
}

// ───────────────────────────── AI ─────────────────────────────

model KnowledgeItem {
  id         String   @id @default(cuid())
  businessId String
  title      String
  content    String
  category   String   @default("FAQ")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AiConversation {
  id          String       @id @default(cuid())
  businessId  String
  channel     String       @default("WEBSITE")
  visitorId   String
  customerId  String?
  enquiryId   String?
  status      String       @default("AI")
  summary     String?
  transcript  Json         @default("[]")
  apiMessages Json         @default("[]")
  uncertain   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  toolCalls   AiToolCall[]

  @@index([businessId, createdAt])
  @@index([businessId, visitorId])
}

model AiToolCall {
  id             String         @id @default(cuid())
  businessId     String
  conversationId String
  tool           String
  input          Json
  output         Json?
  ok             Boolean        @default(true)
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

// ───────────────────────────── Reporting / System ─────────────────────────────

model DailyReport {
  id         String   @id @default(cuid())
  businessId String
  date       String
  pngPath    String?
  pdfPath    String?
  data       Json
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  type       String
  title      String
  body       String?
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, read])
}

model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  userId     String?
  actor      String    @default("USER")
  action     String
  entity     String
  entityId   String?
  data       Json?
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

// One delivery attempt of a daily report to one recipient (e.g. WhatsApp image + Excel).
model ReportDelivery {
  id         String   @id @default(cuid())
  businessId String
  reportId   String?
  date       String
  channel    String   @default("WHATSAPP")
  recipient  String
  formats    String[]
  status     String
  error      String?
  trigger    String   @default("SCHEDULE")
  createdAt  DateTime @default(now())

  @@index([businessId, date])
}

// ───────────────────────────── WhatsApp messaging ─────────────────────────────

// Linked-device (QR) session keys, one row per key, so the link survives restarts and redeploys.
// value is BufferJSON-serialised text. Deleting a business's rows unlinks it.
model WhatsAppAuth {
  businessId String
  key        String
  value      String   @db.Text
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, key])
}

// One outgoing WhatsApp message (invoice, payment reminder, product update, test).
// batchId groups the messages of one bulk send so its progress can be followed.
model MessageLog {
  id         String   @id @default(cuid())
  businessId String
  provider   String
  kind       String
  recipient  String
  name       String?
  customerId String?
  refId      String?
  batchId    String?
  status     String
  error      String?
  userId     String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, batchId])
}

// ─────────────── Employees: attendance & leave ───────────────

// A person who works for the business. userId links them to a login so they can punch in themselves.
model Employee {
  id          String         @id @default(cuid())
  businessId  String
  code        String
  name        String
  phone       String?
  email       String?
  designation String?
  department  String?
  joinDate    DateTime?
  salary      Decimal?       @db.Decimal(12, 2)
  shiftStart  String         @default("09:00")
  shiftEnd    String         @default("18:00")
  leaveQuota  Int            @default(12)
  weekOff     String         @default("SUN")
  userId      String?
  active      Boolean        @default(true)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  attendance  Attendance[]
  leaves      LeaveRequest[]

  @@unique([businessId, code])
  @@index([businessId])
}

// One row per employee per day (date is YYYY-MM-DD in the business timezone).
// status: PRESENT | HALF_DAY | ABSENT | LEAVE | HOLIDAY | WEEK_OFF
model Attendance {
  id          String    @id @default(cuid())
  businessId  String
  employeeId  String
  date        String
  status      String    @default("PRESENT")
  punchIn     DateTime?
  punchOut    DateTime?
  minutes     Int       @default(0)
  lateMinutes Int       @default(0)
  source      String    @default("MANUAL")
  note        String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([businessId, date])
}

// type: CASUAL | SICK | PAID | UNPAID   status: PENDING | APPROVED | REJECTED
model LeaveRequest {
  id          String    @id @default(cuid())
  businessId  String
  employeeId  String
  type        String    @default("CASUAL")
  fromDate    String
  toDate      String
  days        Decimal   @db.Decimal(5, 1)
  reason      String?
  status      String    @default("PENDING")
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([employeeId])
}

// ─────────────── Banking ───────────────

// provider: MANUAL (statement import / entries). A live feed (Account Aggregator) would add its own value.
model BankAccount {
  id             String            @id @default(cuid())
  businessId     String
  name           String
  bankName       String?
  accountMask    String?
  ifsc           String?
  openingBalance Decimal           @default(0) @db.Decimal(14, 2)
  openingDate    DateTime?
  provider       String            @default("MANUAL")
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]

  @@index([businessId])
}

// hash de-duplicates re-imported statement lines; importId groups one upload so it can be undone.
model BankTransaction {
  id          String      @id @default(cuid())
  businessId  String
  accountId   String
  date        DateTime
  description String
  reference   String?
  debit       Decimal     @default(0) @db.Decimal(14, 2)
  credit      Decimal     @default(0) @db.Decimal(14, 2)
  balance     Decimal?    @db.Decimal(14, 2)
  mode        String?
  category    String?
  source      String      @default("IMPORT")
  importId    String?
  hash        String
  createdAt   DateTime    @default(now())
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, hash])
  @@index([businessId, date])
  @@index([accountId, date])
}
