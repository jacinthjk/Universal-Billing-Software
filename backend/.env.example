# PostgreSQL (Render external database URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB"

PORT=5000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"
# Public URL of the frontend (used for shareable website / invoice links)
PUBLIC_APP_URL="http://localhost:5173"
# Public URL of this API (used for uploaded file URLs)
PUBLIC_API_URL="http://localhost:5000"

# Local object storage folder (logos, product images, invoices, reports)
STORAGE_DIR="./storage"

# AI (optional). Without a key the agent falls back to the built-in rule-based provider.
ANTHROPIC_API_KEY=""

# Payments: "manual" (default) or "razorpay"
PAYMENT_PROVIDER="manual"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp Business Cloud API (Meta) - daily report delivery. Leave empty to disable sending.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Approved templates with an IMAGE / DOCUMENT header (needed to message you outside the 24-hour window)
WHATSAPP_REPORT_IMAGE_TEMPLATE=""
WHATSAPP_REPORT_DOC_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
